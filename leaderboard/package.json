{
  "name": "fvspec-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Workspace for packages/api, packages/web, and packages/worker",
  "license": "MIT-Apache",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=packages/web",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:worker": "npm run dev --workspace=packages/worker",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=packages/web",
    "build:api": "npm run build --workspace=packages/api",
    "build:worker": "npm run build --workspace=packages/worker",
    "start": "npm run start --workspace=packages/web",
    "start:api": "npm run start --workspace=packages/api",
    "start:web": "npm run start --workspace=packages/web",
    "start:worker": "npm run start --workspace=packages/worker",
    "lint": "npm exec --workspaces -- eslint .",
    "lint:fix": "npm exec --workspaces -- eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present || true",
    "format": "npx prettier --write --ignore-path ./../.gitignore ."
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.53.1"
  }
}
