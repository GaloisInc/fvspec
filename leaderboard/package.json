{
  "name": "fvspec-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Workspace for packages/api, packages/web, and packages/worker",
  "license": "MIT-Apache",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter ./packages/web run dev",
    "dev:api": "pnpm --filter ./packages/api run dev",
    "dev:worker": "pnpm --filter ./packages/worker run dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter ./packages/web run build",
    "build:api": "pnpm --filter ./packages/api run build",
    "build:worker": "pnpm --filter ./packages/worker run build",
    "start": "pnpm --filter ./packages/web run start",
    "start:api": "pnpm --filter ./packages/api run start",
    "start:web": "pnpm --filter ./packages/web run start",
    "start:worker": "pnpm --filter ./packages/worker run start",
    "lint": "pnpm -r exec eslint .",
    "lint:fix": "pnpm -r exec eslint . --fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean || true",
    "format": "pnpm exec prettier --write --ignore-path ./../.gitignore ."
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.22.1"
  }
}
