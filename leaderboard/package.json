{
  "name": "fvspec-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "fvspec leaderboard — dataset explorer and API",
  "license": "MIT-Apache",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start",
    "start:api": "tsx server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "npx prettier --write --ignore-path ./../.gitignore .",
    "clean": "rm -rf .next"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "hono": "^4.12.8",
    "lucide-react": "^0.577.0",
    "lz-string": "^1.5.0",
    "next": "^16.1.7",
    "pino": "^10.3.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.4",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/postcss": "^4",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.7",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
