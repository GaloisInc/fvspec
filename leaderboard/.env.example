# Standalone API server (server/index.ts, used with `npm run dev:api`)
PORT=3001

# Dataset source for prebuild script (scripts/precompute-dataset.ts)
# Checked in order: CLI arg > DATASET_PATH > DATASET_URL > default S3 URL
# DATASET_PATH=../benchmark/artifacts/dataset-out/fvspec.jsonl
# DATASET_URL=https://fvspec-vercel-assets.s3.us-west-2.amazonaws.com/fvspec.jsonl

# Frontend API URL override
# Development with standalone server: http://localhost:3001
# Vercel / integrated: leave unset (defaults to /api, handled by Next.js route)
# NEXT_PUBLIC_API_URL=http://localhost:3001
