# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fvspec

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3001
API_TOKEN=your-secret-token-here

# Worker
API_BASE_URL=http://localhost:3001
TIME_LIMIT_SEC=7200
MEMORY_MB=16000
ARTIFACTS_DIR=/tmp/leaderboard_artifacts
RUNNER_NAME=local-runner
RUNNER_TRUST=internal
WORKER_CONCURRENCY=1

# Optional: Use Docker for sandboxing (leave empty to use host tooling)
# TOOLCHAIN_IMAGE=leanprover/lean4:v4.14.0
