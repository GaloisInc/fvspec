# Standalone API server (server/index.ts, used with `npm run dev:api`)
PORT=3001

# Dataset source (standalone server only — Vercel uses DATASET_URL)
# DATASET_PATH=../benchmark/artifacts/dataset-out/fvspec.jsonl

# Remote dataset URL (used by both Vercel and standalone when DATASET_PATH is unset)
# Defaults to S3: https://fvspec-vercel-assets.s3.us-west-2.amazonaws.com/fvspec.jsonl
# DATASET_URL=

# Frontend API URL override
# Development with standalone server: http://localhost:3001
# Vercel / integrated: leave unset (defaults to /api, handled by Next.js route)
# NEXT_PUBLIC_API_URL=http://localhost:3001
