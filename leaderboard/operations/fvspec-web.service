[Unit]
Description=fvspec Leaderboard Web Frontend
After=network.target

[Service]
Type=simple
User=quinnd
WorkingDirectory=/home/quinnd/fvspec/leaderboard/packages/web
EnvironmentFile=-/home/quinnd/fvspec/leaderboard/.env
Environment="PORT=3000"
Environment="HOSTNAME=localhost"
Environment="NEXT_PUBLIC_API_URL=/api"
ExecStart=/home/quinnd/.local/share/pnpm/pnpm start
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
