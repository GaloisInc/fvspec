[Unit]
Description=fvspec Leaderboard Web Frontend
After=network.target

[Service]
Type=simple
User=quinnd
WorkingDirectory=/home/quinnd/fvspec/leaderboard/packages/web
# Note: Do not use EnvironmentFile here - PORT would conflict with API service
# EnvironmentFile=-/home/quinnd/fvspec/leaderboard/.env
Environment="PORT=3000"
Environment="HOSTNAME=localhost"
Environment="NEXT_PUBLIC_API_URL=/api"
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
