[Unit]
Description=fvspec Leaderboard API
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=quinnd
WorkingDirectory=/home/quinnd/fvspec/leaderboard/packages/api
EnvironmentFile=/home/quinnd/fvspec/leaderboard/.env
Environment="PORT=3002"
# Use tsx to run TypeScript directly (no build step needed)
ExecStart=/home/quinnd/.local/share/pnpm/pnpm exec tsx src/index.ts
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
